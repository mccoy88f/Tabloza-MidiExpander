[Unit]
Description=Tabloza MidiExpander — FluidSynth MIDI Orchestrator
After=sound.target network.target rtpmidid.service
Wants=rtpmidid.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/tabloza/src/midi_orchestrator.py
WorkingDirectory=/opt/tabloza/src
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=TABLOZA_DATA_DIR=/var/lib/tabloza
RuntimeDirectory=tabloza
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target
